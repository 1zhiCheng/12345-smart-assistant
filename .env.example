# ============================================================
# 芜湖政务 Agent · 环境变量样例
# 复制为 .env 并填写真实密钥：cp .env.example .env
# ============================================================

# ---------- LLM：DeepSeek（主力对话模型） ----------
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TEMPERATURE=0.1
DEEPSEEK_MAX_TOKENS=2048
DEEPSEEK_TIMEOUT=60
INTAKE_LLM_ENABLED=false        # 确认允许脱敏诉求发往所配模型服务后再改为 true
INTAKE_LLM_MIN_EVIDENCE_RATIO=0.75
INTAKE_LLM_MAX_INPUT_CHARS=12000

# ---------- 中转站：非 DeepSeek 模型（bge 等，OpenAI 兼容） ----------
RELAY_API_KEY=
RELAY_BASE_URL=
RELAY_MODEL=zai-org/GLM-5.2

# ---------- Embedding（向量模型，经中转站） ----------
# provider: relay=经中转站；local=本地 sentence-transformers；hash=离线确定性向量（仅开发/测试）
# SiliconFlow 的 BAAI/bge-m3 输出 1024 维；更换模型时必须同步调整 EMBEDDING_DIM。
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DIM=512
EMBEDDING_ALLOW_HASH_FALLBACK=false  # 生产禁止真实模型失败后伪装成 hash 向量
ROUTING_SEMANTIC_ENABLED=true
ROUTING_PROTOTYPE_PATH=backend/resources/routing_prototypes.bge-small-zh-v1.5.json
ROUTING_SEMANTIC_TOP_K=3
ROUTING_KEYWORD_BONUS=0.08

# ---------- 存储 ----------
STORAGE_MODE=mongo            # mongo | memory
MONGO_INITDB_ROOT_USERNAME=wuhu12345_admin   # MongoDB 根账号（compose 初始化用）
MONGO_INITDB_ROOT_PASSWORD=change-me-strong-mongo-password
REDIS_PASSWORD=change-me-strong-redis-password
MONGODB_URI=mongodb://wuhu12345_admin:change-me-strong-mongo-password@localhost:27017/wuhu_12345?authSource=admin
MONGODB_DB=wuhu_12345
REDIS_ADDR=redis://:change-me-strong-redis-password@localhost:6379
REDIS_DB=0
ASYNC_STREAM_NAME=wuhu12345:jobs
ASYNC_JOB_MAX_ATTEMPTS=3
ASYNC_JOB_RECLAIM_IDLE_MS=60000
ASYNC_WORKER_HEARTBEAT_SECONDS=10
ASYNC_WORKER_STALE_SECONDS=30
WORKER_READINESS_REQUIRED=true
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
REDIS_SOCKET_TIMEOUT_SECONDS=5
DEPENDENCY_FAIL_FAST=true

# ---------- 检索 ----------
VECTOR_BACKEND=mongo          # memory | mongo | chroma | milvus
VECTOR_CACHE_TTL_SECONDS=30   # 多 Pod 最迟 30 秒看到其他进程新增向量
HYBRID_TOPK=5
BM25_TOP=20
VECTOR_TOP=20
RERANKER_ENABLED=false        # 默认不外发；明确授权并配置兼容服务后再启用
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# ---------- 服务 ----------
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
# 显式列出允许的前端来源（生产替换为实际域名；带凭据请求不允许通配符）
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# ---------- pi 智能体服务（Harness + Loop 深度整合） ----------
PI_AGENT_ENABLED=false
PI_AGENT_URL=http://localhost:8100   # Docker 内为 http://pi-agent:8100
INTERNAL_API_TOKEN=change-me-internal-api-token

# ---------- 上传限制 ----------
MAX_UPLOAD_MB=20                # 文档上传大小上限(MB)

# ---------- 12345 录音转写 ----------
# 使用提供 /audio/transcriptions 的 OpenAI 兼容服务；未配置时前端自动降级为人工补录。
ASR_PROVIDER=disabled           # disabled | openai_compatible | faster_whisper
ASR_API_KEY=
ASR_BASE_URL=https://api.openai.com/v1
ASR_MODEL=whisper-1
ASR_LANGUAGE=zh
ASR_TIMEOUT=120
ASR_MAX_UPLOAD_MB=25
ASR_LOCAL_MODEL_PATH=models/faster-whisper-turbo
ASR_SPEAKER_MODEL_PATH=models/speaker-diarization/campplus.onnx  # CAM++ 中文声纹模型
ASR_LOCAL_DEVICE=auto           # RTX 显卡优先 cuda，失败自动回退 cpu
ASR_LOCAL_COMPUTE_TYPE=auto     # cuda 默认 float16，cpu 默认 int8

# ---------- 登录限流 ----------
LOGIN_MAX_ATTEMPTS=5            # 登录失败次数上限（窗口内）
LOGIN_WINDOW_SECONDS=300        # 限流窗口(秒)

# ---------- Loop 进化 ----------
LOOP_ENABLED=true
SKILL_MIN_CLUSTER=20          # Skill 挖掘：7 天窗口内同模式问题最小次数
SKILL_SANDBOX_MIN_SUCCESS=0.85
HOOK_HIGH_CONFIDENCE=0.9      # 高置信度自动生效阈值（人在环上/环外）
LOOP_PHASE=human_in_loop      # human_in_loop | human_on_loop | human_out_of_loop（Phase 1 起步，逐步退出）

# ---------- 鉴权 ----------
AUTH_SECRET=change-me-strong-auth-secret
AUTH_TOKEN_TTL_HOURS=24
SEED_DEMO_USERS=false          # 生产默认不创建固定口令演示账号
SEED_OPERATIONAL_DEMO_DATA=false # 生产默认不加载演示运行态
BOOTSTRAP_ADMIN_USERNAME=      # 首次部署可临时设置；创建后应从 Secret 中移除
BOOTSTRAP_ADMIN_PASSWORD=      # 至少12位，不得使用示例密码
BOOTSTRAP_ADMIN_NAME=系统管理员

# ---------- 人工审核 Loop（部门渐进退出） ----------
REVIEW_QUESTION_COUNT=3         # 新文档入库后自动生成的测试题数量
REVIEW_ACCURACY_THRESHOLD=0.8   # 正确率超过该阈值后取消人工审核（人退出 Loop）
REVIEW_MIN_SAMPLES=5            # 达到阈值所需的最小审核样本数（积累反馈）
